# Nightclubmap – Apache. Die App braucht kein mod_rewrite.
# Hier steht nur, was nicht ausgeliefert werden darf.

Options -Indexes

<FilesMatch "\.(yaml|yml|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
