# Nightclubmap – Caddy + PHP. Zwei Zeilen anpassen: Domain und php-fpm-Socket.
#
# Die App braucht vom Webserver nichts Besonderes: keine Umschreibregeln,
# keinen Kachel-Cache, keine Umgebungsvariablen. Nur zweierlei:
#   * die Clubdaten (*.yaml) und den Zwischenspeicher nicht ausliefern,
#   * PHP ausführen.

clubs.example.de {
	root * /var/www/clubs
	encode zstd gzip

	# Daten sind keine Webseiten
	@daten path *.yaml *.yml /data /data/* /connectors /connectors/*
	handle @daten {
		respond 404
	}

	handle {
		php_fastcgi unix//run/php/php-fpm.sock
		file_server
	}
}
